<div id="<%= dom_id transit_route %>">
  <p class="my-5">
    <strong class="block font-medium mb-1">Company branch:</strong>
    <%= transit_route.company_branch_id %>
  </p>

  <% if action_name != "show" %>
    <%= link_to "Show this transit route", transit_route, class: "rounded-lg py-3 px-5 bg-gray-100 inline-block font-medium" %>
    <%= link_to 'Edit this transit route', edit_transit_route_path(transit_route), class: "rounded-lg py-3 ml-2 px-5 bg-gray-100 inline-block font-medium" %>
    <hr class="mt-6">
  <% end %>
</div>
