<div id="<%= dom_id staff %>">
  <p class="my-5">
    <strong class="block font-medium mb-1">Company branch:</strong>
    <%= staff.company_branch_id %>
  </p>

  <p class="my-5">
    <strong class="block font-medium mb-1">Mtu:</strong>
    <%= staff.mtu_id %>
  </p>

  <% if action_name != "show" %>
    <%= link_to "Show this staff", staff, class: "rounded-lg py-3 px-5 bg-gray-100 inline-block font-medium" %>
    <%= link_to 'Edit this staff', edit_staff_path(staff), class: "rounded-lg py-3 ml-2 px-5 bg-gray-100 inline-block font-medium" %>
    <hr class="mt-6">
  <% end %>
</div>
