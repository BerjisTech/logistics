<div id="<%= dom_id occupied_storage %>">
  <p class="my-5">
    <strong class="block font-medium mb-1">Storage:</strong>
    <%= occupied_storage.storage_id %>
  </p>

  <p class="my-5">
    <strong class="block font-medium mb-1">Client:</strong>
    <%= occupied_storage.client_id %>
  </p>

  <% if action_name != "show" %>
    <%= link_to "Show this occupied storage", occupied_storage, class: "rounded-lg py-3 px-5 bg-gray-100 inline-block font-medium" %>
    <%= link_to 'Edit this occupied storage', edit_occupied_storage_path(occupied_storage), class: "rounded-lg py-3 ml-2 px-5 bg-gray-100 inline-block font-medium" %>
    <hr class="mt-6">
  <% end %>
</div>
