<div id="<%= dom_id company_staff %>">
  <p class="my-5">
    <strong class="block font-medium mb-1">Company branch:</strong>
    <%= company_staff.company_branch_id %>
  </p>

  <% if action_name != "show" %>
    <%= link_to "Show this company staff", company_staff, class: "rounded-lg py-3 px-5 bg-gray-100 inline-block font-medium" %>
    <%= link_to 'Edit this company staff', edit_company_staff_path(company_staff), class: "rounded-lg py-3 ml-2 px-5 bg-gray-100 inline-block font-medium" %>
    <hr class="mt-6">
  <% end %>
</div>
