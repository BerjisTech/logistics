<div id="<%= dom_id transit %>">
  <p class="my-5">
    <strong class="block font-medium mb-1">Company branch:</strong>
    <%= transit.company_branch_id %>
  </p>

  <p class="my-5">
    <strong class="block font-medium mb-1">Transit route:</strong>
    <%= transit.transit_route_id %>
  </p>

  <% if action_name != "show" %>
    <%= link_to "Show this transit", transit, class: "rounded-lg py-3 px-5 bg-gray-100 inline-block font-medium" %>
    <%= link_to 'Edit this transit', edit_transit_path(transit), class: "rounded-lg py-3 ml-2 px-5 bg-gray-100 inline-block font-medium" %>
    <hr class="mt-6">
  <% end %>
</div>
