<div class="d-flex align-items-start justify-content-start h-[100%] w-[100%] p-5 <%= background_color %>">
  <div class="d-flex align-items-end justify-content-end h-[100%] flex-column">
    <div class="px-2 py-2 <%= border_left_color %> flex-grow-1"></div>
    <div class="py-2 text-center writing-vertical-lr whitespace-nowrap flex-grow-0 text-slate-100 text-2xl font-semibold uppercase tracking-widest leading-4">
      <%= left_name %>
    </div>
    <div class="px-2 py-5 <%= border_left_color %> flex-grow-0"></div>
  </div>
  <div class="d-flex align-items-start justify-content-start h-[100%] flex-column flex-grow-1">
    <div class="<%= border_top_color %> py-2 w-[100%]"></div>
    <div class="flex-grow-1 <%= data_text_color %> p-5">
      <%= data %>
    </div>
    <div class="d-flex align-items-end justify-content-end w-[100%]">
      <div class="py-2 px-2 <%= border_bottom_color %> flex-grow-1"></div>
      <div class="text-center px-2 whitespace-nowrap flex-grow-0 text-slate-100 text-2xl font-semibold uppercase tracking-widest leading-4">
        <%= bottom_name %>
      </div>
      <div class="py-2 px-5 <%= border_bottom_color %> flex-grow-0"></div>
    </div>
  </div>
  <div class="d-flex align-items-start justify-content-start h-[100%] px-2 <%= border_right_color %>"></div>
</div>
