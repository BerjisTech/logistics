<div id="<%= dom_id messaging %>">
  <p class="my-5">
    <strong class="block font-medium mb-1">Sender:</strong>
    <%= messaging.sender %>
  </p>

  <p class="my-5">
    <strong class="block font-medium mb-1">Receiver:</strong>
    <%= messaging.receiver %>
  </p>

  <p class="my-5">
    <strong class="block font-medium mb-1">Replying to:</strong>
    <%= messaging.replying_to %>
  </p>

  <p class="my-5">
    <strong class="block font-medium mb-1">Message:</strong>
    <%= messaging.message %>
  </p>

  <p class="my-5">
    <strong class="block font-medium mb-1">Read:</strong>
    <%= messaging.read %>
  </p>

  <p class="my-5">
    <strong class="block font-medium mb-1">Deleted:</strong>
    <%= messaging.deleted %>
  </p>

  <% if action_name != "show" %>
    <%= link_to "Show this messaging", messaging, class: "rounded-lg py-3 px-5 bg-gray-100 inline-block font-medium" %>
    <%= link_to 'Edit this messaging', edit_messaging_path(messaging), class: "rounded-lg py-3 ml-2 px-5 bg-gray-100 inline-block font-medium" %>
    <hr class="mt-6">
  <% end %>
</div>
