<div id="<%= dom_id company_branch %>">
  <p class="my-5">
    <strong class="block font-medium mb-1">Company:</strong>
    <%= company_branch.company_id %>
  </p>

  <% if action_name != "show" %>
    <%= link_to "Show this company branch", company_branch, class: "rounded-lg py-3 px-5 bg-gray-100 inline-block font-medium" %>
    <%= link_to 'Edit this company branch', edit_company_branch_path(company_branch), class: "rounded-lg py-3 ml-2 px-5 bg-gray-100 inline-block font-medium" %>
    <hr class="mt-6">
  <% end %>
</div>
